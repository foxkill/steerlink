{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "printWidth": 120,
    "endOfLine": "lf",
    "trailingComma": "all",
    "sortImports": {},
    "ignorePatterns": ["dist/**", "**/*.md", "package-lock.json"],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
