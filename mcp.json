{
    "mcpServers": {
        "steerlink": {
            "command": "npx",
            "args": ["-y", "steerlink@0.1.14"],
            "env": {
                "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
                "ACP_CONNECTOR_AUTH_MODE": "api_key",
                "ACP_CONNECTOR_SESSION_VIEW": "${ACP_CONNECTOR_SESSION_VIEW}"
            }
        }
    }
}
