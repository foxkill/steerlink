{
  "name": "grokbot-acp-connector",
  "version": "0.1.0",
  "description": "MCP-Server (stdio), der ACP-Agents wie Claude Code für Grok Bot steuerbar macht",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:smoke": "npm run build && RUN_SMOKE=1 vitest run test/smoke.test.ts",
    "demo": "npm run build && node --import tsx scripts/demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.93.0",
    "@agentclientprotocol/sdk": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "bin": {
    "grokbot-acp-connector": "dist/main.js"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
