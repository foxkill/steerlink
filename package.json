{
    "name": "steerlink",
    "version": "0.1.13",
    "description": "MCP server that lets Grok Bot and other MCP hosts steer and remote-control Claude Code, Codex and other ACP coding agents, with approval of every change",
    "keywords": [
        "acp",
        "agent client protocol",
        "agent-client-protocol",
        "ai coding agent",
        "approve changes",
        "claude",
        "claude code",
        "claude code fernsteuern",
        "claude code steuern",
        "claude-code",
        "code review",
        "codex",
        "coding agent",
        "control claude code",
        "delegate coding",
        "grok bot",
        "mcp",
        "model-context-protocol",
        "pair programming",
        "remote control claude code",
        "steer claude code"
    ],
    "homepage": "https://github.com/foxkill/steerlink#readme",
    "bugs": {
        "url": "https://github.com/foxkill/steerlink/issues"
    },
    "license": "MIT",
    "author": "Stefan Martin",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/foxkill/steerlink.git"
    },
    "funding": {
        "type": "individual",
        "url": "https://paypal.me/foxkilldev"
    },
    "bin": {
        "steerlink": "dist/main.js"
    },
    "files": [
        "dist/**/*.js",
        "dist/ui/*.html"
    ],
    "type": "module",
    "main": "dist/main.js",
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && npm run build:ui",
        "build:ui": "node --import tsx scripts/build-ui.ts",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
        "test": "vitest run",
        "validate:plugin": "node --import tsx scripts/validate-plugin.ts",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run validate:plugin",
        "test:package": "vitest run --config vitest.e2e.config.ts test/e2e/package.test.ts",
        "test:smoke": "npm run build && vitest run --config vitest.e2e.config.ts test/e2e/smoke.test.ts",
        "test:view": "vitest run --config vitest.e2e.config.ts test/e2e/view.test.ts",
        "demo": "npm run build && node --import tsx scripts/demo.ts",
        "view:host": "node --import tsx scripts/view-host.ts",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test:package",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "plugin:local": "node --import tsx scripts/local-plugin.ts"
    },
    "dependencies": {
        "@agentclientprotocol/claude-agent-acp": "^0.93.0",
        "@agentclientprotocol/sdk": "^1.9.0",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@modelcontextprotocol/ext-apps": "2.0.3",
        "@types/node": "^22.20.5",
        "esbuild": "0.28.2",
        "oxfmt": "0.73.0",
        "oxlint": "1.88.0",
        "oxlint-tsgolint": "7.0.2004",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^4.1.12"
    },
    "engines": {
        "node": ">=20.19"
    }
}
